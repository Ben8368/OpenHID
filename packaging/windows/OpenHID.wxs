<?xml version="1.0" encoding="utf-8"?>

<!--
  Windows Installer authoring for the OpenHID MSI (built with the WiX
  toolset v6 by release.yml's `windows-msi` job).

  - Per-user scope: installs to %LocalAppData%\Programs\OpenHID without
    elevation; raw HID access and the input hook need no admin rights.
  - The packaged exe is the already-Authenticode-signed build from the
    `windows` job; the MSI itself is signed on top by the same job.
  - Build-time defines (passed via `wix build -d`):
      Version       numeric x.y.z ProductVersion (0.0.0 on non-tag dispatches)
      ExeFile       path to the signed openhid-desktop exe to package
      AgentExeFile  path to the signed openhid-agent exe to package
      OverlayExeFile path to the signed openhid-overlay exe to package
      CliExeFile    path to the signed openhid (CLI) exe to package
      IconFile      optional override for the app .ico (Add/Remove Programs
                    entry); defaults to the committed design/icon/openhid.ico
                    below, so the release workflow needs no extra define

  - Requires WixToolset.UI.wixext (the progress-only dialog flow) and
    WixToolset.Util.wixext (util:CloseApplication below); the windows-msi job
    installs both pinned to the same version as wix itself.
-->

<!--
  One UpgradeCode per architecture, fixed forever: Windows Installer treats
  x64 and arm64 packages both as "64-bit", so a shared UpgradeCode would let
  FindRelatedProducts cross-grade one architecture over the other.
-->
<?if $(sys.BUILDARCH) = arm64 ?>
  <?define UpgradeCode = "636353DA-6989-47FB-B975-8CDBD263168E" ?>
<?else?>
  <?define UpgradeCode = "242A428C-68ED-4E10-9F46-A8154D1B4842" ?>
<?endif?>

<!-- Resolved relative to this .wxs, so a plain
     `wix build packaging\windows\OpenHID.wxs` finds it from any cwd. -->
<?ifndef IconFile ?>
  <?define IconFile = "$(sys.SOURCEFILEDIR)..\..\design\icon\openhid.ico" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="OpenHID"
           Manufacturer="OpenHID contributors"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenHID is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Start interactive installs immediately, but keep the standard progress
      and terminal dialogs so closing the OpenHID processes below cannot make
      a successful, cancelled, or failed install look like it simply vanished.
      Windows Installer suppresses this authored UI at the /qn UI level, so
      staged updates remain non-interactive.
    -->
    <UI>
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="UserExit" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="EndDialog"
               Value="Return"
               Order="999" />

      <ui:WixUI Id="WixUI_Common" />
    </UI>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OpenHID">
          <!-- The CLI cannot sit beside the GUI: Windows paths are
               case-insensitive, so `openhid.exe` and the GUI's `OpenHID.exe`
               are the same file name in one directory. WiX catches it as
               duplicate component GUIDs (WIX0369) — and the portable zip's
               staging would silently overwrite the GUI with the CLI. A `bin`
               subdirectory keeps the documented command name intact, and it is
               `bin` (not INSTALLFOLDER) that goes on PATH. -->
          <Directory Id="BINFOLDER" Name="bin" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <!-- Installed as plain OpenHID.exe: inside the install dir the file
             name is the product name. -->
        <File Id="OpenHIDExe" Name="OpenHID.exe" Source="$(var.ExeFile)" KeyPath="yes" />
      </Component>
      <Component Id="AgentExecutable">
        <!-- The background agent owns all device I/O, the input hook, and the
             IPC server; the GUI is a thin client that spawns a sibling
             `openhid-agent.exe` when the pipe is absent (agent_binary_path()
             in openhid-desktop's ipc_client.rs) — the name must match exactly. -->
        <File Id="OpenHIDAgentExe" Name="openhid-agent.exe" Source="$(var.AgentExeFile)" KeyPath="yes" />
      </Component>
      <Component Id="OverlayExecutable">
        <!-- Warm, non-activating GPUI host for the Actions Ring. -->
        <File Id="OpenHIDOverlayExe" Name="openhid-overlay.exe" Source="$(var.OverlayExeFile)" KeyPath="yes" />
      </Component>
      <Component Id="SourceNotices" Guid="*">
        <File Id="SourceNotice" Name="NOTICE" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" KeyPath="yes" />
        <File Id="SourceLicenseMit" Name="LICENSE-MIT" Source="$(sys.SOURCEFILEDIR)..\..\LICENSE-MIT" />
        <File Id="SourceLicenseApache" Name="LICENSE-APACHE" Source="$(sys.SOURCEFILEDIR)..\..\LICENSE-APACHE" />
        <File Id="HidppLicense" Name="LICENSE-HIDPP" Source="$(sys.SOURCEFILEDIR)..\..\crates\openhid-hidpp\LICENSE" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Cli" Directory="BINFOLDER">
      <Component Id="CliExecutable">
        <!-- The `openhid` CLI: device inventory and the HID++ diagnostics
             (`openhid list`, `openhid diag features`) that docs/USAGE.md and
             both issue templates ask users to paste into reports. Linux
             installs the same binary to /usr/bin/openhid and macOS embeds it
             at Contents/MacOS/openhid; Windows shipped no CLI at all, so
             device reports from Windows arrived with the diagnostic blocks
             empty. The name must stay `openhid.exe` — that is the command
             every doc spells out, which is exactly why it needs its own
             directory (see BINFOLDER above).

             BINFOLDER joins the user's PATH so the command actually resolves
             in a shell. System="no" keeps that to HKCU\Environment, matching
             the package's perUser scope: no elevation, and an uninstall
             removes the entry again (Permanent="no"). Part="last" appends
             rather than shadowing anything already on PATH. -->
        <File Id="OpenHIDCliExe" Name="openhid.exe" Source="$(var.CliExeFile)" KeyPath="yes" />
        <Environment Id="OpenHIDCliPath"
                     Name="PATH"
                     Value="[BINFOLDER]"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="no" />
      </Component>
    </ComponentGroup>

    <!--
      Upgrades hit a file-in-use on both exes once the agent autostarts (HKCU
      Run key, registered by the agent on first run). The agent is headless —
      it owns no top-level window, so WM_CLOSE / end-session messages never
      reach it — hence TerminateProcess (which requires RebootPrompt="no").
      Terminating it is safe: it holds no unsaved state, and the GUI's
      spawn-retry (or the Run key at next login) restarts the new binary.
      The GUI does have a window, so ask it to close first; terminate as the
      fallback so silent upgrades (msiexec /qn, the future auto-updater) never
      stall on a FilesInUse prompt.

      Target matches by image NAME, machine-wide by design of the element —
      there is no per-directory scoping. That is the correct scope here, not
      an accident: both processes are per-user singletons (profile-scoped
      agent.lock / openhid.lock), so the only same-user copies that can be
      running — whichever install they came from — are exactly the ones
      holding the IPC pipe and the locks the upgraded install needs freed.
      Other users' processes survive: this is a per-user package, and the
      deferred close action runs without the rights to terminate them.
    -->
    <util:CloseApplication Id="CloseOverlay"
                           Target="openhid-overlay.exe"
                           CloseMessage="no"
                           RebootPrompt="no"
                           Timeout="2"
                           TerminateProcess="0" />
    <util:CloseApplication Id="CloseAgent"
                           Target="openhid-agent.exe"
                           CloseMessage="no"
                           RebootPrompt="no"
                           Timeout="2"
                           TerminateProcess="0" />
    <!--
      Target matching is case-insensitive, so this row also matches a running
      `openhid.exe` (the CLI). That is harmless and needs no row of its own:
      the CLI is short-lived and holds no state, no lock, and no IPC pipe, so
      terminating one mid-upgrade costs the user a re-run at worst — while
      leaving it out of the match would let a long `assets sync` hold the
      install directory and stall the upgrade on a FilesInUse prompt.
    -->
    <util:CloseApplication Id="CloseGui"
                           Target="OpenHID.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="5"
                           TerminateProcess="0" />

    <StandardDirectory Id="ProgramMenuFolder">
      <!-- Shortcuts cannot be a component KeyPath; the HKCU marker stands in,
           which also fits the per-user scope. -->
      <Component Id="StartMenuShortcut">
        <Shortcut Id="OpenHIDShortcut"
                  Name="OpenHID"
                  Target="[INSTALLFOLDER]OpenHID.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\OpenHID"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
        <!-- Bind the receipt to this copy, not an unrelated portable GUI. -->
        <RegistryValue Root="HKCU"
                       Key="Software\OpenHID"
                       Name="InstallLocation"
                       Type="string"
                       Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <!-- App pulls in the GUI, agent, and overlay; Cli adds bin\openhid.exe. -->
      <ComponentGroupRef Id="App" />
      <ComponentGroupRef Id="Cli" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Add/Remove Programs icon. The Start Menu shortcut needs no Icon of
         its own: it targets OpenHID.exe, whose embedded icon resource (see
         crates/openhid-desktop/build.rs) the shell picks up automatically. -->
    <Icon Id="OpenHIDIco" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="OpenHIDIco" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Ben8368/OpenHID" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Ben8368/OpenHID" />
  </Package>
</Wix>
